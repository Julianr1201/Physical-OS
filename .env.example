# Physical OS listens on loopback unless you explicitly opt into a LAN bind.
PHYSICAL_OS_BIND=127.0.0.1
PHYSICAL_OS_PORT=4747
PHYSICAL_OS_ALLOW_LAN=0

# Directory for SQLite, the cookie secret, and MQTT CA files.
PHYSICAL_OS_DATA_DIR=./data

# Browser origin allowed to call the API. Used for CSRF origin checks.
PHYSICAL_OS_ORIGIN=http://127.0.0.1:3000

# Set to 1 only when the console is served over HTTPS.
PHYSICAL_OS_COOKIE_SECURE=0

# Optional. When unset, the server generates and stores one under DATA_DIR.
# PHYSICAL_OS_COOKIE_SECRET=

# High-risk actuation stays disabled unless this exact value is set.
# Even then, only isolated simulator devices can be commanded, and only with approval.
# PHYSICAL_OS_SIM_HIGH_RISK=isolated

# Optional LLM. Disabled when either variable is unset.
# The provider may only return a validated plan. It cannot call tools.
# PHYSICAL_OS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# PHYSICAL_OS_LLM_API_KEY=
# PHYSICAL_OS_LLM_MODEL=llama3.1

# MQTT password is referenced by name from integration config. Never commit the value.
# PHYSICAL_OS_MQTT_PASSWORD=
